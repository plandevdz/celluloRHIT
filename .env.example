# Copier en .env sur le serveur (chmod 600). Ne jamais versionner .env.

# Adresse(s) par lesquelles les PC joignent le serveur (IP réservée et/ou nom DNS interne).
SERVER_ADDRESS=10.0.0.50
# URL utilisée dans les liens (mails, activation de compte).
PUBLIC_URL=https://10.0.0.50

# Mot de passe PostgreSQL : lettres et chiffres uniquement (ex. sortie de `openssl rand -hex 24`).
POSTGRES_PASSWORD=remplacer-par-openssl-rand-hex-24

# Facultatif : en test, tous les avis sont adressés à cette boîte autorisée.
MAIL_TEST_RECIPIENT=

# Durées de session
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=10
