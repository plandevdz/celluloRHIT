# Copier en .env sur le serveur (chmod 600). Ne jamais versionner .env.
# Modules, envoi Exchange, échéances et sauvegarde se règlent aussi dans
# Administration → Paramètres / Sauvegardes : ce qui y est enregistré remplace ces valeurs.

# Adresse(s) par lesquelles les PC joignent le serveur (IP réservée et/ou nom DNS interne).
SERVER_ADDRESS=10.0.0.50
# Si SERVER_ADDRESS contient plusieurs adresses, indiquer ici la seule IP du serveur.
# TLS_DEFAULT_SNI=10.0.0.50
# URL utilisée dans les liens (mails, activation de compte).
PUBLIC_URL=https://10.0.0.50

# Mot de passe PostgreSQL (ex. sortie de `openssl rand -hex 24`). Éviter le caractère $ (interprété par compose).
POSTGRES_PASSWORD=remplacer-par-openssl-rand-hex-24

# Facultatif : en test, tous les avis sont adressés à cette boîte autorisée.
MAIL_TEST_RECIPIENT=

# Durées de session
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=10

# ------------------------------------------------------------------ périmètre du pilote
# Modules facultatifs fermés : « pilote » = véhicules, logiciels, inventaire
# (étiquettes et campagnes QR), mutation, départ, états. Liste possible, ex.
# « vehicules,etats ». Laisser vide pour tout ouvrir (après recette de chaque
# module). Une valeur inconnue empêche le démarrage.
MODULES_DESACTIVES=pilote

# ------------------------------------------------------------------ avis (Exchange Online)
# journal : aucun mail envoyé (défaut). graph : envoi par Microsoft Graph.
MAIL_MODE=journal
# Boîte d'expédition dédiée (créée par l'administrateur Microsoft 365).
MAIL_SENDER=
# Pilote : seuls ces domaines reçoivent des mails (séparés par des virgules).
MAIL_ALLOWED_DOMAINS=
# Application Entra d'envoi (rôle « Application Mail.Send » limité à la boîte).
# Certificat et clé privée : ./secrets/graph-envoi.crt et ./secrets/graph-envoi.key
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=

# ------------------------------------------------------------------ archivage SharePoint
# desactive (défaut) ou sharepoint. Identité distincte de celle d'envoi.
ARCHIVE_MODE=desactive
ARCHIVE_TENANT_ID=
ARCHIVE_CLIENT_ID=
# Certificat et clé : ./secrets/graph-archive.crt et ./secrets/graph-archive.key
ARCHIVE_SITE_ID=
ARCHIVE_DRIVE_ID=
ARCHIVE_ROOT=Celluloplast

# ------------------------------------------------------------------ échéances
# Alerte avant échéance (jours) : pièces de véhicule, location, abonnements.
ALERT_DAYS=30
# Alerte avant entretien (km).
ALERT_KM=1000
# Relance « accès à vérifier » après l'heure de coupure (minutes).
ESCALATION_MINUTES=60
